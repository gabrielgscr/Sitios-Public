@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="py-5 text-center">
    <div class="container">
        <h1 class="display-4 fw-semibold mb-3"><i class="bi bi-people-fill"></i> Personas App</h1>
        <p class="lead text-muted mb-4">
            Administra personas de forma simple: listar, crear, editar y eliminar.
        </p>
        <div class="d-flex gap-2 justify-content-center">
            <a class="btn btn-primary btn-lg" asp-page="/Personas/Index">
                <i class="bi bi-card-list"></i> Ver Personas
            </a>
            <a class="btn btn-outline-secondary btn-lg" asp-page="/Personas/Create">
                <i class="bi bi-plus-circle"></i> Crear Persona
            </a>
        </div>
    </div>
</section>


